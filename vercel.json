{
  "version": 2,
  "framework": null,
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "redirects": [
    { "source": "/listhub", "destination": "/listhub/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/listhub/embed", "destination": "/embed.html" },
    { "source": "/embed", "destination": "/embed.html" },
    { "source": "/listhub/", "destination": "/index.html" },
    { "source": "/listhub/:path*", "destination": "/:path*" }
  ],
  "headers": [
    {
      "source": "/((?!assets/|listhub/assets/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/(listhub/)?assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(listhub/)?embed(\\.html)?",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors *" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
